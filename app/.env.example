# Kopiér denne fil til ".env" og udfyld med rigtige værdier for MASKINEN
# den kører på. Hver maskine (udvikling, server) har sin egen ".env" –
# filen er ikke sporet i git og deles derfor ikke automatisk ved opdatering.

# Session-cookie – generér en unik nøgle pr. miljø:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Sæt til "true" i PRODUKTION, når Caddy (TLS-terminerende reverse proxy,
# se deploy/provision-server.ps1) kører foran uvicorn – ellers sender
# browseren ikke session-cookien tilbage. Lad stå tom/false ved lokal
# udvikling uden TLS.
HTTPS_ONLY=

# Entra ID (Microsoft SSO) – udfyld hvis/når SSO tages i brug
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# SMTP (udsendelse af mails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
