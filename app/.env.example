# Kopiér denne fil til ".env" og udfyld med rigtige værdier for MASKINEN
# den kører på. Hver maskine (udvikling, server) har sin egen ".env" –
# filen er ikke sporet i git og deles derfor ikke automatisk ved opdatering.

# Session-cookie – generér en unik nøgle pr. miljø:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Entra ID (Microsoft SSO) – udfyld hvis/når SSO tages i brug
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# SMTP (udsendelse af mails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
